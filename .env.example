# Local development only. Copy to .env; never commit credentials.
DATABASE_URL=postgresql+psycopg://pack_app:local-development-only@127.0.0.1:5432/pack
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:local-admin-only@127.0.0.1:5432/pack
AUTH_MODE=local
LOCAL_ORGANIZATION=org_demo_alpha
LOCAL_OPERATOR=local-operator
LOCAL_ROLE=supervisor
STORAGE_MODE=local
WORKER_ENABLED=true
STORAGE_ROOT=.local/images
# Optional Render/Supabase deployment: STORAGE_MODE=supabase.
# Use a private bucket; this legacy service-role JWT stays server-side only.
SUPABASE_URL=
# Public browser key, distinct from the private service-role key.
SUPABASE_PUBLISHABLE_KEY=
# Hosted AUTH_MODE=supabase; same assigned organization in the web app and worker.
PACK_ORGANIZATION=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence
# Explicit opt-in: none (default), ollama (local worker), or legacy azure.
# Keep none until the selected model is installed and a bounded test is ready.
MODEL_PROVIDER=none
# Hosted option: gemini. The only reviewed model is gemini-2.5-flash.
# Keep billing disabled in Google AI Studio; the flag records owner confirmation,
# it cannot enforce provider-side billing. Never enable paid billing to fix quotas.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false
HOSTED_MODEL_REVIEW_REQUIRED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
LOCAL_MODEL_REVIEW_REQUIRED=true
# Candidate local model: qwen3-vl:2b-instruct. No external model API key required.
# Azure is not used by the current deployment plan.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_VISION_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# If API key is absent, use DefaultAzureCredential.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=evidence
MODEL_TIMEOUT_SECONDS=45
# Controller mode requires organizer clarification. Baseline is one batched vision call.
AGENT_MODE=batched
# Legacy Entra only; current hosted plan uses Supabase Auth. Never expose local auth publicly.
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_CLIENT_ID=
ENTRA_SCOPE=
# Optional anonymous isolated demo. Use a random 32+ character secret, never commit it.
DEMO_ENABLED=false
DEMO_SIGNING_SECRET=
DEMO_TTL_HOURS=24
DEMO_DAILY_SESSIONS=25
DAILY_MODEL_LIMIT=100
# Allowed origins for cross-origin frontend (e.g. Vercel deployment: https://your-app.vercel.app)
ALLOWED_ORIGINS=

# Integrated local backend (separate from Pack UI/service); no model/cloud calls.
# Generate local development bearer accounts with python -m backend.integrated.dev init.
# Bind to 127.0.0.1 only. Database URL must point to local PostgreSQL; STORAGE_MODE=local.
INTEGRATED_USERS_FILE=.local/integrated-users.json

# Integrated Round 3 preview. Local stays the default; inference remains disabled.
INTEGRATED_MODE=local
INTEGRATED_SYNTHETIC_ONLY=true
# Hosted settings and migration steps: docs/ROUND3_READINESS.md.
# DATABASE_URL may use Neon or Supabase PostgreSQL with pack_app and TLS.
