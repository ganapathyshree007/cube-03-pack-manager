{
  "$defs": {
    "Instance": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "minLength": 1,
          "title": "Instance Id",
          "type": "string"
        },
        "sku": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sku"
        },
        "variant": {
          "default": "",
          "title": "Variant",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/Region"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "instance_id",
        "sku"
      ],
      "title": "Instance",
      "type": "object"
    },
    "Region": {
      "additionalProperties": false,
      "description": "Provider-returned primary-image region, normalized x/y/width/height.",
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Region",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "agent_started_at": {
      "format": "date-time",
      "title": "Agent Started At",
      "type": "string"
    },
    "configuration_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "evidence_record_id": {
      "minLength": 1,
      "title": "Evidence Record Id",
      "type": "string"
    },
    "decision": {
      "anyOf": [
        {
          "enum": [
            "seal",
            "stop_and_fix",
            "uncertain"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Decision"
    },
    "instances": {
      "items": {
        "$ref": "#/$defs/Instance"
      },
      "title": "Instances",
      "type": "array"
    },
    "count_resolved": {
      "title": "Count Resolved",
      "type": "boolean"
    },
    "model_calls": {
      "maximum": 1,
      "minimum": 0,
      "title": "Model Calls",
      "type": "integer"
    },
    "failure_kind": {
      "anyOf": [
        {
          "enum": [
            "provider",
            "schema",
            "infrastructure"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Kind"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "observed_cost": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Cost"
    },
    "cost_provenance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Provenance"
    }
  },
  "required": [
    "case_id",
    "source_sha256",
    "agent_started_at",
    "configuration_hash",
    "evidence_record_id",
    "decision",
    "instances",
    "count_resolved",
    "model_calls"
  ],
  "title": "Prediction",
  "type": "object"
}
