# Backend API URL for cross-origin deployment (e.g. Render, Railway, Fly.io)
# If left empty, API requests will use the same origin (relative path /api/v1/...)
VITE_API_URL=

# Local operations workspace: server-only proxy target, never a browser secret.
# Optional override; default is the verified local integrated API.
INTEGRATED_API_TARGET=http://127.0.0.1:8010
# Do not put bearer tokens in VITE_* variables or environment files used for builds.
# Connect using the private local account JSON or the token input at runtime.
