{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Record Contract",
  "type": "object",
  "properties": {
    "record_id": { "type": "string" },
    "schema_version": { "type": "string" },
    "organization_id": { "type": "string" },
    "client_id": { "type": "string" },
    "agent": { "type": "string" },
    "subject": { "type": "string", "description": "The unit_id being evaluated" },
    "captured_at": { "type": "string", "format": "date-time" },
    "operator_label": { "type": "string" },
    "images": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_key": { "type": "string" },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "UNCERTAIN"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "detail": { "type": "string" },
          "model_version": { "type": "string" },
          "latency_ms": { "type": "integer" }
        },
        "required": ["check_key", "verdict", "confidence", "detail"]
      }
    },
    "outcome": {
      "type": "string",
      "enum": ["restock", "refurbish", "liquidate", "dispose", "pending_review"]
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "original_verdict": { "type": "string" },
          "revised_verdict": { "type": "string" },
          "reason": { "type": "string" },
          "operator_id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["original_verdict", "revised_verdict", "reason", "operator_id", "timestamp"]
      }
    },
    "status": {
      "type": "string",
      "enum": ["completed", "pending_review", "error"]
    },
    "content_hash": { "type": "string" }
  },
  "required": [
    "record_id",
    "schema_version",
    "organization_id",
    "subject",
    "captured_at",
    "images",
    "checks",
    "outcome",
    "status",
    "content_hash"
  ]
}
